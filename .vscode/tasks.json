{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "vite: dev server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activesBegins": true,
          "beginsPattern": "VITE v",
          "endsPattern": "Local"
        }
      }
    },
    {
      "label": "vite: build",
      "type": "npm",
      "script": "build",
      "group": "build",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "vite: preview production build",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "dependsOn": "vite: build",
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activesBegins": true,
          "beginsPattern": "vite preview|Local",
          "endsPattern": "Local"
        }
      }
    }
  ]
}
